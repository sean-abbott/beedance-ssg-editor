{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "beedance-ssg-editor",
  "identifier": "com.criticalloop.beedance-ssg-editor",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "beedance-ssg-editor",
        "width": 1280,
        "height": 860
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/zola"]
  }
}
