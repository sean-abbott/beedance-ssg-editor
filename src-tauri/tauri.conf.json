{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "beedance-ssg-editor",
  "identifier": "com.criticalloop.beedance-ssg-editor",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "beedance-ssg-editor",
        "width": 1280,
        "height": 860
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/zola"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
